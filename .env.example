# משתני סביבה של אתר האינדקס (index.gofreeil.com)

# ── Strapi המשותף (api.gofreeil.com) ──
# STRAPI_TOKEN: API Token מסוג Full Access — נוצר בפאנל האדמין של api.gofreeil.com
# (Settings → API Tokens → Create). דרוש לכתיבות (טופס עסק, ביקורות, מונים) ולסקריפט הייבוא.
STRAPI_TOKEN=
# ברירת מחדל https://api.gofreeil.com אם ריק
STRAPI_URL=https://api.gofreeil.com

# ── Google (התחברות + סקריפט הייבוא מהגיליון) ──
PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# מזהה גיליון העסקים (נחוץ רק לסקריפט הייבוא החד-פעמי)
SPREADSHEET_ID=

# ── Google Analytics (מסך /admin/stats) ──
# הכול אופציונלי: בלי המשתנים האלה המסך עובד ומציג את הסטטיסטיקה הפנימית
# (כרטיסיות, צפיות, חשיפות טלפון, גידול המאגר), ורק חלק ה-GA מסומן "לא מחובר".
#
# GA_MEASUREMENT_ID: מזהה המדידה G-XXXXXXX. ברגע שהוא מוגדר, ה-gtag נטען
# בדפדפן והגולשים מתחילים להיספר. זה כל מה שצריך כדי *לאסוף* נתונים.
GA_MEASUREMENT_ID=
# GA_PROPERTY_ID: מזהה ה-Property המספרי של GA4 (לא G-XXXX) — דרוש כדי
# *לקרוא* את הנתונים חזרה למסך הסטטיסטיקה.
GA_PROPERTY_ID=
# הדומיין שנספר. הנכס ב-GA משותף לכמה אתרים, וכל אתר מסנן לפי עצמו.
GA_HOSTNAME=index.gofreeil.com
# פרטי ה-service account שקורא מ-GA. אותו service account שמשמש את שאר
# האתרים מתאים גם כאן — צריך רק להוסיף אותו כ-Viewer בנכס.
# אפשרות א' (הכי קלה): להדביק את כל קובץ ה-JSON שהורד.
GA_SA_JSON=
# אפשרות ב': שני משתנים נפרדים (המפתח תומך גם ב-\n מילוליים).
GA_SA_CLIENT_EMAIL=
GA_SA_PRIVATE_KEY=
# אם מגדירים Vercel Cron ל-/api/cron/visitors — הסוד שלו. בלי cron הרענון
# קורה ממילא בכל כניסת אדמין לפאנל, לכל היותר אחת ל-15 דקות.
CRON_SECRET=

# ── CARTO (אריחי הבסיס של המפות) ──
# מספטמבר 2026 CARTO דורשת מפתח גם לאריחים החינמיים; בלעדיו האריחים מגיעים
# עם סימן מים "API KEY REQUIRED". המפתח חינמי: carto.com/basemaps/apikey
# (אימייל, הדומיין index.gofreeil.com ותיאור קצר — בלי חשבון). ציבורי
# מטבעו (נשלח מהדפדפן), ולכן PUBLIC_. חובה גם ב-Vercel.
PUBLIC_CARTO_API_KEY=
